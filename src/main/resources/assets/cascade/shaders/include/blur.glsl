#version 330

vec4 blur(sampler2D tex, vec2 uv, vec2 texelSize, float radius) {
    if (radius <= 0.0)return texture(tex, uv);

    const vec2 vogelDisk[32] = vec2[](
        vec2(0.1250000, 0.0000000),
        vec2(-0.1596450, 0.1462479),
        vec2(0.0244362, -0.2784383),
        vec2(0.2012223, 0.2624588),
        vec2(-0.3692676, -0.0653182),
        vec2(0.3498024, -0.2225157),
        vec2(-0.1170020, 0.4352419),
        vec2(-0.2231357, -0.4296341),
        vec2(0.4841152, 0.1767979),
        vec2(-0.5036411, 0.2078959),
        vec2(0.2427881, -0.5188246),
        vec2(0.1794146, 0.5720012),
        vec2(-0.5407571, -0.3133795),
        vec2(0.6343695, -0.1394646),
        vec2(-0.3871456, 0.5506753),
        vec2(-0.0894400, -0.6901996),
        vec2(0.5490720, 0.4627580),
        vec2(-0.7388785, 0.0305553),
        vec2(0.5389548, -0.5363326),
        vec2(-0.0360577, 0.7797915),
        vec2(-0.5128179, -0.6145265),
        vec2(0.8123597, 0.1093013),
        vec2(-0.6883103, 0.4789091),
        vec2(0.1880855, -0.8360615),
        vec2(0.4350338, 0.7591907),
        vec2(-0.8504486, -0.2713156),
        vec2(0.8261021, -0.3816809),
        vec2(-0.3578875, 0.8551558),
        vec2(-0.3194081, -0.8880335),
        vec2(0.8499090, 0.4466874),
        vec2(-0.9440344, 0.2488453),
        vec2(0.5365950, -0.8345303)
    );

    vec4 sum = vec4(0.0);
    for (int i = 0; i < 32; i++) {
        sum += texture(tex, uv + vogelDisk[i] * texelSize * radius);
    }
    return sum / 32.0;
}