{
  "schemaVersion": 1,
  "id": "${id}",
  "version": "${version}",
  "name": "${name}",
  "description": "A rendering library.",
  "authors": [
    "Starred"
  ],
  "contact": {},
  "environment": "*",
  "entrypoints": {
    "client": [
      {
        "value": "foo.starred.cascade.Cascade",
        "adapter": "kotlin"
      }
    ]
  },
  "mixins": [
    "${id}.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.18",
    "fabric-api": "*",
    "fabric-language-kotlin": ">=${kotlin}",
    "minecraft": "${minecraft}"
  },
  "accessWidener": "${accessWidener}",
  "custom": {
    "modmenu": {
      "update_checker": false,
      "badges": ["library"]
    }
  }
}
